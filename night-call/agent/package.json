{
  "name": "nightcall-agents",
  "version": "0.1.0",
  "description": "Night Call agent roles hosted on Amazon Bedrock AgentCore",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "lint": "eslint --config ../eslint.config.mjs src scripts --max-warnings 0",
    "test": "node --import tsx --test src/*.test.ts",
    "deploy": "tsx scripts/deploy.ts"
  },
  "dependencies": {
    "@strands-agents/sdk": "^1.17.0",
    "bedrock-agentcore": "^0.4.4",
    "openai": "^6.49.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1131.0",
    "@aws-sdk/client-ecr": "^3.1131.0",
    "@aws-sdk/client-iam": "^3.1131.0",
    "@aws-sdk/credential-providers": "^3.1131.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
